---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import portrait from '../../public/images/olivia-portrait.jpg';

const featuredMetrics = [
  'Processed 10,000+ vehicle images from Kampala highways',
  'YOLO-based vehicle detection with mAP: 0.85',
  'OCR-based license plate recognition with CER: 5%',
  'Speed estimation within +/-3 km/h accuracy',
  '100+ automated tickets/day via SMS',
  'Traffic dashboard used by 20+ officers daily',
  '40% efficiency improvement over manual systems',
];

const groundwaterMetrics = [
  'Ensemble learning and ANN models with strong classification performance',
  'Spatial and structural aquifer variables as key predictors',
  'Exploratory aquifer potential maps for data-scarce environments',
  'Target leakage mitigation by excluding resistivity-based predictors',
  'Spatial autocorrelation bias reduced with GroupKFold',
  'Interpretability via permutation importance and feature stability analysis',
  'Managed limited data with repeated cross-validation',
];

const researchInterests = [
  'Reliable machine learning systems',
  'Geospatial AI and spatial modeling',
  'Distributed AI and scalable pipelines',
  'Computer vision and intelligent sensing',
  'AI for infrastructure and environmental systems',
];

const experience = [
  {
    role: 'Head of IoT Department',
    company: 'Queensland & Leeds Engineers',
    dates: 'Jan 2024 - Present',
    text: 'Led system integration, distributed monitoring, ICT infrastructure, and IoT-backend projects, achieving 99.9% uptime and reducing latency by 30%.',
  },
  {
    role: 'Python Software Developer',
    company: '02G Ventures DBA Kin-Keepers (USA)',
    dates: 'May 2024 - Aug 2025',
    text: 'Built ElderCHAT backend systems for 1,000+ users and developed multi-agent AI workflows using LangChain, n8n, Hugging Face, and NLP pipelines.',
  },
  {
    role: 'Data Engineer (Team Lead)',
    company: 'Buvaaz Commerce',
    dates: 'Jul 2024 - Dec 2024',
    text: 'Built pipelines processing 1M+ records daily with 99% data accuracy, led a team of 4, and optimized ML models improving accuracy by 15%.',
  },
  {
    role: 'Research Intern',
    company: 'AirQo',
    dates: 'Jun 2023 - Nov 2023',
    text: 'Built automated pipelines for 100,000+ environmental records daily and developed ML models and visualizations for air quality prediction.',
  },
  {
    role: 'Data Science & Software Engineering Research Intern',
    company: 'Marconi Research and Innovations Laboratory',
    dates: 'May 2022 - Oct 2022',
    text: 'Contributed to maize disease classification models achieving 92% accuracy across 5+ crop disease categories.',
  },
];

const credentials = [
  // {
  //   title: 'Master\'s in Mechatronics Engineering',
  //   place: 'Ashesi University, Accra Ghana',
  //   dates: 'Sept 2026 - Present',
  //   text: 'Integrates knowledge of core areas in automation and production engineering with mathematics, physics, and numerical methods to develop a better understanding of mechatronics applications in a wide range of industry sectors.',
  // },
  {
    title: 'Data Science Lab',
    place: 'WorldQuant University, Washington DC USA',
    dates: 'Jun 2026 - Present',
    text: 'Focuses on learning to query databases, clean data, build machine learning models, and create predictive visualizations using publicly available datasets. You also work with different technologies, including files, APIs, and SQL/NoSQL databases.',
  },
  {
    title: 'Africa Climate and Health Data Capacity Accelerator Network',
    place: 'Global Partnership for Sustainable Development Data',
    dates: 'Feb 2025 - Jun 2025',
    text: 'Engaged in a multi-disciplinary initiative utilizing data science pipelines to address critical climate and health variables in Africa.',
  },
  {
    title: 'Bachelor of Science in Computer Engineering',
    place: 'Makerere University, Kampala Uganda',
    dates: 'Aug 2020 - May 2024',
    text: 'Earned the degree with a 3.89/5.0 CGPA. Program featured a comprehensive Computer Science major paired with an Electrical and Telecommunications Engineering, focusing on the intersection of software development, network systems, and hardware design.',
  },
];

const skillGroups = [
  {
    title: 'AI & Systems',
    skills: ['Machine Learning', 'Computer Vision', 'Real-Time Systems', 'Distributed Systems', 'Model Optimization'],
  },
  {
    title: 'Tools',
    skills: ['Python', 'C/C++', 'PyTorch', 'TensorFlow', 'Hugging Face', 'Airflow', 'Docker', 'CI/CD', 'LangChain', 'n8n', 'CrewAI'],
  },
  {
    title: 'Data',
    skills: ['PostgreSQL', 'MySQL', 'SQL Server', 'Neo4j', 'Power BI', 'Tableau'],
  },
];

const exploring = [
  'Efficient inference for on-device AI',
  'Real-time perception pipelines',
  'Adaptive AI systems under resource constraints',
  'Robust ML for geospatial and environmental decision-support systems',
];

const featuredProjects = [
  {
    title: 'Machine Learning-Assisted Classification Of Ves-Derived Aquifer Potential Indicators: A Hydrogeophysical Investigation In Anambra State, Nigeria.',
    tech: 'Python • Scikit-learn • Pandas • GeoPandas • Folium • Seaborn • Matplotlib • Spatial Analysis • Machine Learning • Hydrogeophysics',
    text: 'Developed a hydrogeophysical machine learning framework for exploratory classification of VES-derived aquifer potential indicators using spatial analysis, feature engineering, ensemble learning, and leakage-aware validation strategies on geophysical survey data from 207 Vertical Electrical Sounding (VES) locations in Anambra State, Nigeria.',
    dates: 'Jun 2024 - Feb 2026',
    highlights: groundwaterMetrics,
    link: null,
    linkText: null,
    submitted: true
  },
  {
    title: 'Intelligent Traffic Surveillance for Real-Time Vehicle Detection, License Plate Recognition, and Speed Estimation',
    tech: 'Python, YOLO, CNNs, OCR, Flask',
    text: 'Developed a real-time computer vision system for automated traffic enforcement using deep learning and sensor-based estimation. The system integrates perception, decision-making, Africa\'s Talking SMS delivery, and a web dashboard into a scalable deployment pipeline.',
    dates: 'Oct 2023 - Sep 2025',
    highlights: featuredMetrics,
    link: 'https://arxiv.org/abs/2601.00344',
    linkText: 'Read Paper',
    submitted: false
  }
];
---

<BaseLayout title="Olivia Nakacwa | Portfolio">
  <main class="relative min-h-screen overflow-hidden bg-paper">
    <Nav />

    <section class="mx-auto grid min-h-screen max-w-6xl items-center gap-10 px-5 pb-16 pt-28 sm:px-8 sm:pt-32 lg:grid-cols-[1.15fr_0.85fr] lg:pb-20 lg:pt-36">
      <div class="relative z-10 max-w-2xl">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-accent">Computer Engineer</p>
        <h1 class="text-4xl font-black leading-tight text-ink sm:text-6xl lg:text-7xl">
          Olivia Nakacwa
        </h1>
        <p class="mt-5 text-xl font-bold leading-tight text-neutral-900 sm:text-3xl">
          Building Scalable AI Systems for Real-World Environments
        </p>
        <p class="mt-6 max-w-xl text-lg font-semibold leading-8 text-neutral-700">
          Computer Engineer specializing in real-time machine learning systems, on-device AI, and perception-driven intelligent systems.
        </p>
        <p class="mt-5 max-w-2xl leading-8 text-neutral-700">
          I design and deploy intelligent systems that operate under real-world constraints, integrating machine learning, distributed systems, and computer vision to solve practical challenges in infrastructure, healthcare, and environmental monitoring.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#projects" class="rounded-md bg-ink px-5 py-3 text-sm font-bold uppercase text-white hover:bg-accent">
            View Projects
          </a>
          <a href="#contact" class="rounded-md border border-ink px-5 py-3 text-sm font-bold uppercase text-ink hover:border-accent hover:text-accent">
            Contact
          </a>
        </div>

        <div class="mt-12 flex flex-wrap gap-4 text-xs font-bold uppercase tracking-[0.16em] text-neutral-700 sm:mt-16 sm:text-sm">
          <a href="https://github.com/NakacwaOlivia" target="_blank" rel="noopener noreferrer" class="hover:text-accent">GitHub</a>
          <a href="https://www.linkedin.com/in/nakacwa-olivia/" target="_blank" rel="noopener noreferrer" class="hover:text-accent">LinkedIn</a>
          <a href="https://orcid.org/0009-0009-9476-1735" target="_blank" rel="noopener noreferrer" class="hover:text-accent">ORCID</a>
          <a href="https://www.researchgate.net/profile/Olivia-Nakacwa" target="_blank" rel="noopener noreferrer" class="hover:text-accent">ResearchGate</a>
          <a href="https://scholar.google.com/citations?hl=en&user=9YCHBzkAAAAJ" target="_blank" rel="noopener noreferrer" class="hover:text-accent">Google Scholar</a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[22rem] lg:mr-0">
        <div class="rounded-lg border border-neutral-200 bg-white p-3 shadow-soft">
          <img src={portrait.src} alt="Olivia Nakacwa portrait" class="aspect-square w-full rounded-md object-cover" />
        </div>
        <div class="mt-4 rounded-lg border border-neutral-200 bg-white p-4">
          <p class="text-sm font-black uppercase tracking-[0.16em] text-accent">Focus</p>
          <p class="mt-2 font-bold leading-7 text-neutral-800">Real-time ML systems, edge AI, computer vision, and scalable data pipelines.</p>
        </div>
      </div>
    </section>

    <section id="about" class="border-t border-neutral-200 bg-white px-5 py-20 sm:px-8">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.65fr_1.35fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent">About</p>
          <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl lg:text-5xl">Intelligent systems for constrained environments</h2>
        </div>
        <div class="space-y-5 text-lg leading-8 text-neutral-700">
          <p>I am a computer engineer focused on designing intelligent systems that operate reliably in real-world environments. My work sits at the intersection of machine learning, distributed systems, and real-time computing, with interests spanning scalable AI systems, geospatial intelligence, computer vision, and on-device inference.</p>
          <p>Growing up and working in Uganda, I observed limitations in digital infrastructure, particularly in systems requiring real-time processing, scalability, and operational reliability. These experiences shaped my interest in building robust AI systems capable of functioning effectively under resource-constrained conditions.</p>
          <p>I have experience developing data-intensive systems and machine learning applications across intelligent infrastructure, computer vision, and hydrogeophysical modeling, including real-time perception systems, spatial machine learning workflows, and distributed data pipelines. My research interests include efficient inference, distributed AI systems, geospatial and environmental AI, and perception-driven intelligent systems that integrate multimodal data such as images, video, sensor streams, and spatial information.</p>
          <p>I am particularly interested in how reliable machine learning systems can support intelligent infrastructure, environmental decision-support systems, and real-world sensing applications where efficiency, adaptability, and robustness are critical.</p>
        </div>
      </div>
    </section>

    <section id="projects" class="bg-[#101010] px-5 py-20 text-white sm:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <div class="min-w-0">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent">Projects</p>
            <h2 class="mt-3 text-3xl font-black sm:text-4xl lg:text-5xl">Featured AI Systems Work</h2>
          </div>
          <div class="flex gap-3">
            <button id="projects-carousel-prev" class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 bg-white text-ink hover:bg-accent hover:text-white hover:border-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button id="projects-carousel-next" class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 bg-white text-ink hover:bg-accent hover:text-white hover:border-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>

        <div class="mt-10 overflow-hidden">
          <div id="projects-carousel-container" class="flex gap-5 transition-transform duration-300">
            {
              featuredProjects.map((project) => (
                <article class="grid w-full flex-shrink-0 gap-6 rounded-lg border border-white/10 bg-[#191919] p-4 shadow-soft sm:p-6 lg:grid-cols-[1.25fr_0.75fr] lg:gap-8 lg:p-8">
                  <div class="min-w-0">
                    <p class="text-sm font-bold uppercase tracking-[0.18em] text-accent">{project.dates}</p>
                    <h3 class="mt-3 break-words text-2xl font-black sm:text-3xl">{project.title}</h3>
                    <p class="mt-3 break-words font-bold text-white/80">{project.tech}</p>
                    <p class="mt-6 text-lg leading-8 text-white/75">
                      {project.text}
                    </p>
                    <div class="mt-7 flex flex-wrap gap-3">
                      {project.link && (
                        <a href={project.link} target="_blank" rel="noopener noreferrer" class="rounded-md bg-accent px-5 py-3 text-sm font-bold uppercase text-white hover:bg-white hover:text-ink">
                          {project.linkText}
                        </a>
                      )}
                      {project.submitted && (
                        <span class="max-w-full rounded-md bg-accent px-5 py-3 text-sm font-bold uppercase text-white">Submitted and Under Review</span>
                      )}
                    </div>
                  </div>
                  <div class="min-w-0 rounded-lg bg-white p-5 text-ink">
                    <h4 class="text-sm font-black uppercase tracking-[0.16em] text-neutral-600">Project Highlights</h4>
                    <ul class="mt-5 space-y-4">
                      {project.highlights.map((metric) => (
                        <li class="border-l-4 border-accent pl-4 font-semibold leading-7 text-neutral-800">{metric}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))
            }
          </div>
        </div>


      </div>
    </section>

    <section id="research" class="bg-paper px-5 py-20 sm:px-8">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_1fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent">Research</p>
          <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl lg:text-5xl">Reliable AI systems for real-world environments</h2>
          <p class="mt-6 text-lg leading-8 text-neutral-700">
            My research focuses on building reliable, scalable AI systems for real-world and resource-constrained environments, with interests spanning machine learning systems, geospatial AI, computer vision, hydrogeophysical modeling, and distributed intelligent infrastructure.
          </p>
          <a href="https://arxiv.org/abs/2601.00344" target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex rounded-md bg-ink px-5 py-3 text-sm font-bold uppercase text-white hover:bg-accent">
            View Preprint
          </a>
          <p class="mt-4 max-w-xl text-sm font-semibold leading-6 text-neutral-600">
            Research on real-time computer vision systems for intelligent traffic surveillance, integrating object detection, OCR, and multi-sensor speed estimation for automated enforcement pipelines. arXiv:2601.00344.
          </p>
          <p class="mt-4 max-w-xl text-sm font-semibold leading-6 text-neutral-600">
            Co-author on a hydrogeophysical machine learning manuscript investigating leakage-aware classification of VES-derived aquifer potential indicators in Anambra State, Nigeria, incorporating spatial validation, uncertainty-aware evaluation, and feature stability analysis.
          </p>
        </div>

        <div class="grid gap-3">
          {
            researchInterests.map((interest) => (
              <div class="rounded-lg border border-neutral-200 bg-white p-5 font-bold text-neutral-800">{interest}</div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="experience" class="bg-white px-5 py-20 sm:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <div class="min-w-0">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent">Experience</p>
            <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl lg:text-5xl">Engineering delivery across AI, data, and infrastructure</h2>
          </div>
          <div class="flex gap-3">
            <button id="carousel-prev" class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 bg-white text-ink hover:bg-accent hover:text-white hover:border-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button id="carousel-next" class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 bg-white text-ink hover:bg-accent hover:text-white hover:border-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>
        <div class="mt-10 overflow-hidden">
          <div id="carousel-container" class="flex gap-5 transition-transform duration-300">
            {
              experience.map((item) => (
                <article class="flex-shrink-0 w-full md:w-[calc(50%-0.625rem)] xl:w-[calc(33.333%-0.666rem)] rounded-lg border border-neutral-200 bg-paper p-6">
                  <p class="text-sm font-black uppercase tracking-[0.16em] text-accent">{item.dates}</p>
                  <h3 class="break-words text-2xl font-black text-ink">{item.role}</h3>
                  <p class="mt-3 font-bold text-accent">{item.company}</p>
                  <p class="mt-5 leading-7 text-neutral-700">{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="bg-paper px-5 py-20 sm:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent">Education & Training</p>
            <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl lg:text-5xl">Academic and applied data science foundation</h2>
          </div>
          <div class="flex gap-3">
            <button id="education-carousel-prev" class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 bg-white text-ink hover:bg-accent hover:text-white hover:border-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button id="education-carousel-next" class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 bg-white text-ink hover:bg-accent hover:text-white hover:border-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>
        <div class="mt-10 overflow-hidden">
          <div id="education-carousel-container" class="flex gap-5 transition-transform duration-500 ease-in-out">
            {
              credentials.map((item) => (
                <article class="flex-shrink-0 w-full md:w-[calc(50%-0.625rem)] xl:w-[calc(33.333%-0.666rem)] rounded-lg border border-neutral-200 bg-white p-6">
                  <p class="text-sm font-black uppercase tracking-[0.16em] text-accent">{item.dates}</p>
                  <h3 class="mt-3 break-words text-2xl font-black text-ink">{item.title}</h3>
                  <p class="mt-3 font-bold text-neutral-800">{item.place}</p>
                  <p class="mt-5 leading-7 text-neutral-700">{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="skills" class="bg-[#191919] px-5 py-20 text-white sm:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent">Skills</p>
        <h2 class="mt-3 text-3xl font-black sm:text-4xl lg:text-5xl">AI systems toolkit</h2>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {
            skillGroups.map((group) => (
              <article class="rounded-lg border border-neutral-200 bg-white p-6">
                <h3 class="text-xl font-black text-ink">{group.title}</h3>
                <div class="mt-5 flex flex-wrap gap-2">
                  {group.skills.map((skill) => <span class="rounded-lg bg-neutral-100 px-3 py-2 text-sm font-semibold text-neutral-800">{skill}</span>)}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-paper px-5 py-20 sm:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <div class="min-w-0">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent">Currently Exploring</p>
            <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl lg:text-5xl">What I am currently exploring</h2>
          </div>
          <div class="flex gap-3">
            <button id="exploring-carousel-prev" class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 bg-white text-ink hover:bg-accent hover:text-white hover:border-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button id="exploring-carousel-next" class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 bg-white text-ink hover:bg-accent hover:text-white hover:border-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>
        <div class="mt-10 overflow-hidden">
          <div id="exploring-carousel-container" class="flex gap-5 transition-transform duration-300">
            {
              exploring.map((item) => (
                <div class="flex-shrink-0 w-full md:w-[calc(33.333%-0.666rem)] rounded-lg border border-neutral-200 bg-white p-6 text-lg font-bold leading-7 text-neutral-800">{item}</div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="bg-white px-5 py-20 sm:px-8">
      <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1fr_0.8fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent">Contact</p>
          <h2 class="mt-3 text-3xl font-black text-ink sm:text-4xl lg:text-5xl">Research collaborations, internships, and AI systems opportunities</h2>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-700">
            I am always open to research collaborations, internships, and opportunities in AI systems and intelligent infrastructure.
          </p>
        </div>
        <div class="flex flex-col justify-center gap-4">
          <a href="mailto:k.nakacwa.olivia@gmail.com" class="break-all rounded-md bg-ink px-5 py-4 text-center text-sm font-bold uppercase text-white hover:bg-accent">
            k.nakacwa.olivia@gmail.com
          </a>
          <a href="https://www.linkedin.com/in/nakacwa-olivia/" target="_blank" rel="noopener noreferrer" class="rounded-md border border-neutral-300 px-5 py-4 text-center text-sm font-bold uppercase text-ink hover:border-accent hover:text-accent">
            LinkedIn
          </a>
          <a href="https://github.com/NakacwaOlivia" target="_blank" rel="noopener noreferrer" class="rounded-md border border-neutral-300 px-5 py-4 text-center text-sm font-bold uppercase text-ink hover:border-accent hover:text-accent">
            GitHub
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  // Experience carousel
  const carouselContainer = document.getElementById('carousel-container');
  const prevButton = document.getElementById('carousel-prev');
  const nextButton = document.getElementById('carousel-next');
  const cards = Array.from(carouselContainer?.children || []);
  let currentIndex = 0;

  const getCardsPerView = () => {
    const width = window.innerWidth;
    if (width >= 1280) return 3;
    if (width >= 768) return 2;
    return 1;
  };

  const updateCarousel = () => {
    if (!carouselContainer || cards.length === 0) return;
    const firstCard = cards[0];
    if (!firstCard || !('offsetWidth' in firstCard)) return;
    const cardWidth = firstCard.offsetWidth + 20;
    const translateX = -currentIndex * cardWidth;
    carouselContainer.style.transform = `translateX(${translateX}px)`;
  };

  prevButton?.addEventListener('click', () => {
    currentIndex = Math.max(0, currentIndex - 1);
    updateCarousel();
  });

  nextButton?.addEventListener('click', () => {
    const cardsPerView = getCardsPerView();
    const maxIndex = Math.max(0, cards.length - cardsPerView);
    currentIndex = Math.min(maxIndex, currentIndex + 1);
    updateCarousel();
  });

  // Projects carousel
  const projectsCarouselContainer = document.getElementById('projects-carousel-container');
  const projectsPrevButton = document.getElementById('projects-carousel-prev');
  const projectsNextButton = document.getElementById('projects-carousel-next');
  const projectCards = Array.from(projectsCarouselContainer?.children || []);
  let projectsCurrentIndex = 0;
  let projectsAutoplayInterval;

  const updateProjectsCarousel = () => {
    if (!projectsCarouselContainer || projectCards.length === 0) return;
    const firstProjectCard = projectCards[0];
    if (!firstProjectCard || !('offsetWidth' in firstProjectCard)) return;
    const projectCardWidth = firstProjectCard.offsetWidth + 20;
    const translateX = -projectsCurrentIndex * projectCardWidth;
    projectsCarouselContainer.style.transform = `translateX(${translateX}px)`;
  };

  const nextProjectSlide = () => {
    // Always show 1 card
    const maxIndex = Math.max(0, projectCards.length - 1);
    // If we're at last slide, go back to first
    if (projectsCurrentIndex === maxIndex) {
      projectsCurrentIndex = 0;
    } else {
      projectsCurrentIndex = Math.min(maxIndex, projectsCurrentIndex + 1);
    }
    updateProjectsCarousel();
  };

  const startProjectsAutoplay = () => {
    if (projectsAutoplayInterval) clearInterval(projectsAutoplayInterval);
    // Auto-play every 5 seconds
    projectsAutoplayInterval = setInterval(nextProjectSlide, 5000);
  };

  const stopProjectsAutoplay = () => {
    if (projectsAutoplayInterval) clearInterval(projectsAutoplayInterval);
  };

  projectsPrevButton?.addEventListener('click', () => {
    projectsCurrentIndex = Math.max(0, projectsCurrentIndex - 1);
    updateProjectsCarousel();
    // Reset autoplay timer after manual navigation
    stopProjectsAutoplay();
    startProjectsAutoplay();
  });

  projectsNextButton?.addEventListener('click', () => {
    nextProjectSlide();
    // Reset autoplay timer after manual navigation
    stopProjectsAutoplay();
    startProjectsAutoplay();
  });

  // Pause autoplay on hover
  projectsCarouselContainer?.addEventListener('mouseenter', stopProjectsAutoplay);
  projectsCarouselContainer?.addEventListener('mouseleave', startProjectsAutoplay);

  // Update both carousels on resize
  window.addEventListener('resize', () => {
    updateCarousel();
    updateProjectsCarousel();
  });

  updateCarousel();
  updateProjectsCarousel();
  // Start autoplay when page loads
  startProjectsAutoplay();

  // Education carousel
  const educationCarouselContainer = document.getElementById('education-carousel-container');
  const educationPrevButton = document.getElementById('education-carousel-prev');
  const educationNextButton = document.getElementById('education-carousel-next');
  const educationCards = Array.from(educationCarouselContainer?.children || []);
  let educationCurrentIndex = 0;
  let educationAutoplayInterval;

  const getEducationCardsPerView = () => {
    const width = window.innerWidth;
    if (width >= 1280) return 3;
    if (width >= 768) return 2;
    return 1;
  };

  const updateEducationCarousel = () => {
    if (!educationCarouselContainer || educationCards.length === 0) return;
    const firstEducationCard = educationCards[0];
    if (!firstEducationCard || !('offsetWidth' in firstEducationCard)) return;
    const educationCardWidth = firstEducationCard.offsetWidth + 20;
    const translateX = -educationCurrentIndex * educationCardWidth;
    educationCarouselContainer.style.transform = `translateX(${translateX}px)`;
  };

  const nextEducationSlide = () => {
    const educationCardsPerView = getEducationCardsPerView();
    const educationMaxIndex = Math.max(0, educationCards.length - educationCardsPerView);
    if (educationCurrentIndex >= educationMaxIndex) {
      educationCurrentIndex = 0;
    } else {
      educationCurrentIndex = Math.min(educationMaxIndex, educationCurrentIndex + educationCardsPerView);
    }
    updateEducationCarousel();
  };

  const startEducationAutoplay = () => {
    if (educationAutoplayInterval) clearInterval(educationAutoplayInterval);
    educationAutoplayInterval = setInterval(nextEducationSlide, 5000);
  };

  const stopEducationAutoplay = () => {
    if (educationAutoplayInterval) clearInterval(educationAutoplayInterval);
  };

  educationPrevButton?.addEventListener('click', () => {
    const educationCardsPerView = getEducationCardsPerView();
    educationCurrentIndex = Math.max(0, educationCurrentIndex - educationCardsPerView);
    updateEducationCarousel();
    stopEducationAutoplay();
    startEducationAutoplay();
  });

  educationNextButton?.addEventListener('click', () => {
    nextEducationSlide();
    stopEducationAutoplay();
    startEducationAutoplay();
  });

  window.addEventListener('resize', () => {
    const educationCardsPerView = getEducationCardsPerView();
    const educationMaxIndex = Math.max(0, educationCards.length - educationCardsPerView);
    educationCurrentIndex = Math.min(educationCurrentIndex, educationMaxIndex);
    updateEducationCarousel();
  });

  updateEducationCarousel();
  startEducationAutoplay();

  // Exploring carousel
  const exploringCarouselContainer = document.getElementById('exploring-carousel-container');
  const exploringPrevButton = document.getElementById('exploring-carousel-prev');
  const exploringNextButton = document.getElementById('exploring-carousel-next');
  const exploringCards = Array.from(exploringCarouselContainer?.children || []);
  let exploringCurrentIndex = 0;

  const getExploringCardsPerView = () => {
    const width = window.innerWidth;
    if (width >= 1280) return 3;
    if (width >= 768) return 2;
    return 1;
  };

  const updateExploringCarousel = () => {
    if (!exploringCarouselContainer || exploringCards.length === 0) return;
    const firstExploringCard = exploringCards[0];
    if (!firstExploringCard || !('offsetWidth' in firstExploringCard)) return;
    const exploringCardWidth = firstExploringCard.offsetWidth + 20;
    const translateX = -exploringCurrentIndex * exploringCardWidth;
    exploringCarouselContainer.style.transform = `translateX(${translateX}px)`;
  };

  exploringPrevButton?.addEventListener('click', () => {
    exploringCurrentIndex = Math.max(0, exploringCurrentIndex - 1);
    updateExploringCarousel();
  });

  exploringNextButton?.addEventListener('click', () => {
    const exploringCardsPerView = getExploringCardsPerView();
    const exploringMaxIndex = Math.max(0, exploringCards.length - exploringCardsPerView);
    exploringCurrentIndex = Math.min(exploringMaxIndex, exploringCurrentIndex + 1);
    updateExploringCarousel();
  });

  // Update exploring carousel on resize
  window.addEventListener('resize', () => {
    updateExploringCarousel();
  });

  updateExploringCarousel();
</script>
